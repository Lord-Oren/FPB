{
  "name": "frog-pond-boys-router",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  // Deliberately empty: add routes only during the approved domain cutover.
  "routes": [],
  "vars": {
    "RENDER_ORIGIN_HOST": "REPLACE-WITH-RENDER-HOST",
    "POND_PUBLIC_SITE": "false",
    "POND_PUBLIC_HOST": "frogpondboys.com",
    "POND_WWW_HOST": "www.frogpondboys.com",
    "POND_DESK_HOST": "desk.frogpondboys.com",
    "POND_PREVIEW_HOST": "preview.frogpondboys.com"
  }
}
