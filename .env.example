# Reference only: enter hosted values in Render's environment settings.
# Never commit actual credentials. The Node entrypoint does not load this file.
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-US-DATABASE-HOST/DATABASE
# Default for external database endpoints: verify the certificate and hostname.
DATABASE_TLS_MODE=verify-full
# Render private network only: set DATABASE_TLS_MODE=render-internal and provide
# the exact internal hostname below. Render supplies RENDER=true automatically.
# DATABASE_RENDER_INTERNAL_HOST=dpg-YOUR-DATABASE-ID-a
ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
ACCESS_AUDIENCE=YOUR-ACCESS-APPLICATION-AUDIENCE
POND_TESTER_EMAILS=owner@example.com
POND_SESSION_SECONDS=28800
POND_PUBLIC_SITE=false
POND_PUBLIC_HOST=frogpondboys.com
POND_WWW_HOST=www.frogpondboys.com
POND_DESK_HOST=desk.frogpondboys.com
POND_PREVIEW_HOST=preview.frogpondboys.com
# Render supplies RENDER_EXTERNAL_HOSTNAME automatically.
# Worker only: RENDER_ORIGIN_HOST=YOUR-SERVICE.onrender.com
