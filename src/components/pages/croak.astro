---
// Croak: the song of the week, from Pond Desk (Home titles & text, and Croak). No audio plays by itself.
import { site } from '../../data/public-site-content.js';
const e = site.home.editorial;
---
<section class="croak-feature"><p>Song of the Week</p>{e.croakTitle ? <><h2>{e.croakTitle}</h2>{e.croakText && <p>{e.croakText}</p>}</> : <h2>A new song is on its way.</h2>}{e.croakUrl && <a href={e.croakUrl} rel="noopener">{e.homeCroakLink || 'Tune in'} <span aria-hidden="true">↗</span></a>}</section>
