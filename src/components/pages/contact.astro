---
// Contact page: every text comes from Pond Desk (Contact). Since the client feedback of 17 Nov 2026 the page keeps
// only "Write to us" (the social channels column is gone; the networks stay in the blue bar and on the home page).
import InquiryForm from '../forms/InquiryForm.astro';
import { site } from '../../data/public-site-content.js';
const { title, intro } = site.contact;
---
<p class="page-intro">{intro}</p>
<div class="contact-layout contact-single">
  <section aria-labelledby="write-us"><h2 id="write-us" class="section-title">{title || 'Write to us'}</h2><InquiryForm kind="contact" /></section>
</div>
