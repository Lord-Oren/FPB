---
// Inside a TV screen: no subtitle any more, only a pointer to the same place as the block title above it.
// The title is the accessible link; this duplicate target is hidden from assistive technologies.
import {nodeHref} from '../../data/public-pages.js';
import {screenHref,screenNewTab} from './screen-href.js';
const {node}=Astro.props;
const newTab=screenNewTab(node);
---
<div class="screen-content"><a class="screen-link" href={screenHref(node,nodeHref)} tabindex="-1" aria-hidden="true" target={newTab?'_blank':undefined} rel={newTab?'noopener noreferrer':undefined}><span class="screen-arrow">{newTab?'↗':screenHref(node,nodeHref).startsWith('#')?'↓':'→'}</span></a></div>
