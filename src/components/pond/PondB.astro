---
// Home page of our modern version (B), layout B V3 (validated by the owner on 20 Nov 2026, interne/design/b-v3/):
// header (logo, stones zone), hero (title block, Grand Central, tagline) beside the three frog panels, which are the
// site's menu; then the pond across the whole width with the four lily-pad TVs. The slot receives HomeSections.
// Every visible text comes from Pond Desk (site wording, editorial fields, structure zones).
import { screenOrder } from './screen-order.js';
import { site } from '../../data/public-site-content.js';
import { zoneNodes, nodeHref } from '../../data/public-pages.js';
import Footer from '../Footer.astro';
import { screenHref, screenNewTab } from './screen-href.js';
import { wordingDefaults } from '../../data/wording.js';
import RubenArtwork from './RubenArtwork.astro';
import BHeader from '../b/BHeader.astro';
import BFrogs from '../b/BFrogs.astro';
// The title follows Site wording. While it keeps its original text, B shows it in its usual mixed case.
const titleText = site.wording['home.title'] === wordingDefaults['home.title'] ? 'Frog Pond Boys' : site.wording['home.title'];
const titleWords = titleText.split(/\s+/).filter(Boolean);
const e = site.home.editorial;
const screens = screenOrder(zoneNodes('screens'));
const arrow = node => screenNewTab(node) ? '↗' : screenHref(node, nodeHref).startsWith('#') ? '↓' : '→';
const message = node => typeof node.message === 'string' ? node.message.trim() : '';
---
<RubenArtwork />
<div class="v3-wrap">
  <BHeader />
</div>
<main id="main" class="v3-home">
  <div class="v3-wrap v3-hero">
    <div class="v3-title v3-blk">
      <h1 class="v3-boo v3-b-title">{titleWords.map(word => <span>{word}</span>)}</h1>
      {e.grandCentral && <p class="v3-gc v3-boo">{e.grandCentral}</p>}
      {e.tagline && <p class="v3-tag">{e.tagline}</p>}
    </div>
    <BFrogs size="large" />
  </div>
  <section class="v3-lake" data-artwork-mode="adapted" aria-label="The pond">
    <div class="v3-bank" aria-hidden="true"></div>
    <div class="v3-water" aria-hidden="true">
      <svg class="v3-caustics" viewBox="0 0 600 370" preserveAspectRatio="none" aria-hidden="true">
        <path d="M20 60c60-20 110 18 170 2s100-30 160-8 110 26 220 4"/><path d="M-10 140c80-26 130 22 210 6s120-40 190-10 120 22 230-6"/>
        <path d="M30 230c50-18 120 14 180 0s110-26 170-4 100 30 210 2"/><path d="M0 310c70-22 140 18 200 4s120-34 180-8 120 20 230-4"/>
        <path d="M80 100c30-12 60 6 90-2" opacity=".6"/><path d="M380 190c40-14 70 8 110-2" opacity=".6"/><path d="M220 280c30-10 60 4 90-4" opacity=".6"/>
      </svg>
    </div>
    <div class="v3-wrap">
      <ul class="v3-screens">{screens.map((node, i) => <li class={`v3-pad v3-pad-${i % 4 + 1}`}>
        <svg class="v3-lily" viewBox="0 0 88.112 88.112" aria-hidden="true" focusable="false"><use href={`#art-lily-${i % 3 + 1}`} /></svg><span class="v3-ring" aria-hidden="true"></span>
        <a class="v3-tv v3-blk v3-press" href={screenHref(node, nodeHref)} target={screenNewTab(node) ? '_blank' : undefined} rel={screenNewTab(node) ? 'noopener noreferrer' : undefined}>
          <span class="v3-tv-label v3-boo">{node.title}</span>
          <span class="v3-set"><svg viewBox="0 0 180 132" aria-hidden="true" focusable="false"><use href="#art-television" /></svg>{message(node) && <span class="v3-glass"><span class="v3-msg">{message(node)}</span></span>}</span>
          <span class="v3-go" aria-hidden="true">{arrow(node)}</span>
        </a>
      </li>)}</ul>
    </div>
  </section>
  <slot />
</main>
<Footer />
