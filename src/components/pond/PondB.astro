---
// Home page of our modern version (B): hero (title + tagline) beside the pond, which is the site's menu
// (frogs → sections, stones → Contact / Join Us / About). The slot receives HomeSections (content under the pond).
import { site } from '../../data/public-site-content.js';
import { zoneNodes,childNodes,nodeHref } from '../../data/public-pages.js';
import Footer from '../Footer.astro';
import ZoneScreen from './ZoneScreen.astro';
import ScreenContent from './ScreenContent.astro';
import RubenArtwork from './RubenArtwork.astro';
---
<header class="masthead">
  <img class="brand-logo" src="data:image/png;base64," alt="Frog Pond Boys" width="90" height="100" />
  <h1><span>Frog</span> <span>Pond</span> <span>Boys</span></h1>
  <p>{site.home.editorial.tagline}</p>
</header>
<main id="main" class="stage">
  <RubenArtwork />
  <section class="pond pond-page" data-artwork-mode="adapted" aria-label="The pond">
    <div class="pond-glow" aria-hidden="true"></div>
    <div class="pond-bank" aria-hidden="true"></div>
    <div class="water" aria-hidden="true">
      <svg class="caustics" viewBox="0 0 600 370" preserveAspectRatio="none" aria-hidden="true">
        <path d="M20 60c60-20 110 18 170 2s100-30 160-8 110 26 220 4"/><path d="M-10 140c80-26 130 22 210 6s120-40 190-10 120 22 230-6"/>
        <path d="M30 230c50-18 120 14 180 0s110-26 170-4 100 30 210 2"/><path d="M0 310c70-22 140 18 200 4s120-34 180-8 120 20 230-4"/>
        <path d="M80 100c30-12 60 6 90-2" opacity=".6"/><path d="M380 190c40-14 70 8 110-2" opacity=".6"/><path d="M220 280c30-10 60 4 90-4" opacity=".6"/>
      </svg>
    </div>
    <div class="rim" aria-hidden="true">
      <svg viewBox="0 0 94.683 46.208" style="left:calc(99.0% - 4.2cqw);top:calc(50.0% - 2cqw);transform:rotate(90deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(97.0% - 4.2cqw);top:calc(62.7% - 2cqw);transform:rotate(106deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(91.2% - 4.2cqw);top:calc(74.3% - 2cqw);transform:rotate(123deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(82.1% - 4.2cqw);top:calc(84.0% - 2cqw);transform:rotate(139deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(17.9% - 4.2cqw);top:calc(84.0% - 2cqw);transform:rotate(221deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(8.8% - 4.2cqw);top:calc(74.3% - 2cqw);transform:rotate(237deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(3.0% - 4.2cqw);top:calc(62.7% - 2cqw);transform:rotate(254deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(1.0% - 4.2cqw);top:calc(50.0% - 2cqw);transform:rotate(270deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(3.0% - 4.2cqw);top:calc(37.3% - 2cqw);transform:rotate(286deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(8.8% - 4.2cqw);top:calc(25.7% - 2cqw);transform:rotate(303deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(91.2% - 4.2cqw);top:calc(25.7% - 2cqw);transform:rotate(417deg)"><use href="#art-stone"/></svg><svg viewBox="0 0 94.683 46.208" style="left:calc(97.0% - 4.2cqw);top:calc(37.3% - 2cqw);transform:rotate(434deg)"><use href="#art-stone"/></svg>
    </div>
    <div class="log" role="group" aria-label="Explore Frog Pond Boys">
      <svg viewBox="0 0 513.172 90.266" aria-hidden="true" focusable="false"><use href="#art-wood"/></svg>
      {zoneNodes('menus').map((node,index,roots)=><div class={`frog-wrap f${index+1}`} data-frog-color={['aero-blue','dandelion','blue-marine'][index%3]} style={`left:${(index+.5)/roots.length*100}%`}>
<span class="frog-tag" aria-hidden="true">{node.title}</span><svg class="frog-art" viewBox="0 0 64.95 60.992" aria-hidden="true"><use href="#art-frog"/></svg><span class="mouth" aria-hidden="true"></span>
<button class="frog-button" type="button" aria-label={`${node.title} menu`} aria-expanded="false" aria-controls={`menu-${node.id}`}></button>
<div class="tongue" id={`menu-${node.id}`} hidden><ul class="menu-flies" aria-label={node.title}>{(childNodes(node.id).length?childNodes(node.id):[node]).map(child=><li><a class="fly" href={nodeHref(child)} target={child.newTab?'_blank':undefined} rel={child.newTab?'noopener noreferrer':undefined}>{child.title}</a></li>)}</ul></div></div>)}
    </div>
    <div class="pads">{zoneNodes('screens').map((node,i)=><article class={`pad p${i+1}`} style={i>=4?`left:${5+(i%2)*47}%;top:${85+Math.floor((i-4)/2)*24}%`:undefined}><svg class="pad-art" viewBox="0 0 88.112 88.112" aria-hidden="true"><use href={`#art-lily-${i%3+1}`}/></svg><div class="pad-body"><h2>{node.title}</h2><div class="tv"><svg class="tv-art" viewBox="0 0 180 132" aria-hidden="true"><use href="#art-television"/></svg><ZoneScreen node={node}/></div></div></article>)}</div>
    <ul class="stones" aria-label="About Frog Pond Boys">{zoneNodes('stones').map((node,i)=><li style={i>=4?`left:${(i-4)*22}%;bottom:-18%`:undefined}><a class="stone" href={nodeHref(node)} target={node.newTab?'_blank':undefined} rel={node.newTab?'noopener noreferrer':undefined}><svg viewBox="0 0 94.683 46.208" aria-hidden="true"><use href="#art-stone"/></svg><span>{node.title}</span></a></li>)}</ul>
  </section>
</main>
<slot />
<Footer />
