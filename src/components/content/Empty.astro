---
// Shown only when the owners removed every item of a section: never a blank page.
// On Case Studies itself the suggestion points to Client Work, so the page never links to itself.
const { here } = Astro.props;
import { site } from '../../data/public-site-content.js';
const w = site.wording;
const next = here === 'case-studies' ? { href: 'client-work.html', label: 'Client Work' } : { href: 'case-studies.html', label: 'Case Studies' };
---
<div class="empty-content"><p class="empty-title">{w['empty.title']}</p><p>{w['empty.suggestion']} <a href={next.href}>{next.label}</a> or <a href="index.html">{w['empty.backHome']}</a>.</p></div>
