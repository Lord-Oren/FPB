---
import ContactFields from './ContactFields.html';
import JoinFields from './JoinFields.html';
import { submissionSettings, contactChannels } from '../../data/communication.js';
import { site } from '../../data/public-site-content.js';
const { kind } = Astro.props;
const hosted = import.meta.env.POND_HOSTED_BUILD === '1';
const local = import.meta.env.DEV || hosted;
const { ready, action, method } = local ? {ready:true,action:`/api/v2/forms/${kind}`,method:'post'} : submissionSettings(kind);
const { privacyUrl } = contactChannels();
const isJoin = kind === 'join';
const Fields = isJoin ? JoinFields : ContactFields;
// V1 contract (B6): one attachment, 10 MB at most. The server checks again.
const attachmentMaxBytes = 10 * 1024 * 1024;
const email = site.contact.email;
---
<form class="inquiry-form" method={method} action={action} enctype={isJoin ? 'multipart/form-data' : undefined} data-inquiry-form data-local={String(local)} data-hosted={String(hosted)} data-ready={String(ready)} data-cv-max-bytes={attachmentMaxBytes} aria-describedby={`${kind}-availability`}>
  <p class="required-note">Fields marked * are required.</p>
  <Fields />
  {local && <input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />}
  {privacyUrl && <p class="form-privacy"><a href={privacyUrl}>Privacy policy</a></p>}
  <div class="form-actions"><button class="send-button" type="submit" disabled={!ready}>{isJoin ? 'Send application' : 'Send message'} <span aria-hidden="true">↗</span></button></div>
  <p id={`${kind}-availability`} class="form-availability" role="status" data-form-status>{hosted ? 'Messages sent here arrive in Pond Desk. No confirmation email is sent yet.' : local ? 'On this computer, messages are saved in Pond Desk. No email is sent.' : ready ? '' : email ? <>Online sending opens soon. Meanwhile, write to us at <a href={`mailto:${email}`}>{email}</a>.</> : 'Online sending opens soon.'}</p>
</form>
