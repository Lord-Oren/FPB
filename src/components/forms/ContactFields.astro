---
import { site } from '../../data/public-site-content.js';
const w = site.wording;
---
<div class="form-row">
  <div class="form-field"><label for="contact-name">{w['form.name']} <span aria-hidden="true">*</span></label><input id="contact-name" name="full_name" autocomplete="name" maxlength="120" required data-trim-required /></div>
  <div class="form-field"><label for="contact-email">{w['form.email']} <span aria-hidden="true">*</span></label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
</div>
<div class="form-field"><label for="contact-message">{w['form.message']} <span aria-hidden="true">*</span></label><textarea id="contact-message" name="message" rows="7" maxlength="5000" required data-trim-required></textarea></div>
